<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A launcher lists and resolves every app, so package visibility filtering is off. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Art from SteamGridDB. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The Wi-Fi signal in the status corner. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Uninstall from the options sheet; the system still asks the owner to confirm. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- The quick panel: brightness (granted once by the owner in Android's "Modify system
         settings") and Do not disturb (granted once in "Do Not Disturb access"). -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Updates from GitHub: Android asks once to allow installs ("Install unknown apps"); after
         that an update to the launcher itself goes in without a second confirm. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Portal">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- The settings gear beside Portal in Android's Default apps → Home app. -->
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Also an ordinary app icon, so it can be tried from Launcher3 before it is Home. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Holding Home opens standby (HomeHoldService); off until turned on in Android's
             accessibility settings. Bound only by the system. -->
        <service
            android:name=".HomeHoldService"
            android:exported="true"
            android:label="@string/home_hold_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_hold_service" />
        </service>

        <!-- The quick panel's seek bar (MediaListener); off until turned on in Android's
             notification access. Bound only by the system. -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="@string/media_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The package installer's answer to an update (Updates.install). -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />
    </application>
</manifest>
